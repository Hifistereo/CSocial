# SQLite in development; switch to a postgresql:// URL + @prisma/adapter-pg for production.
DATABASE_URL="file:./prisma/dev.db"

# 32+ random bytes, hex. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-me"

# Optional: enables video duration fetching (YouTube Data API v3).
# Everything works without it; durations are simply omitted.
# YOUTUBE_API_KEY=""
